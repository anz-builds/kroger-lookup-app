{
  "name": "kroger-price-lookup",
  "version": "1.1.0",
  "description": "Kroger Price Lookup Tool — search products, compare prices, and find deals across Kroger banners",
  "main": "main.js",
  "author": "Fresh Cart",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist-win": "electron-builder --win portable --publish never",
    "dist-mac": "electron-builder --mac dmg --arm64 --publish never",
    "dist-linux": "electron-builder --linux AppImage --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.freshcart.kroger-lookup",
    "productName": "Kroger Price Lookup",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-login.js",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/backend/",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "KrogerPriceLookup-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.shopping",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "KrogerPriceLookup-${version}-arm64.dmg"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility"
    },
    "appImage": {
      "artifactName": "KrogerPriceLookup-${version}-x86_64.AppImage"
    }
  },
  "allowScripts": {
    "electron@45.1.0": true
  }
}
